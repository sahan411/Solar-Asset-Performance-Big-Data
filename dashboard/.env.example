# SolarIQ dashboard — example environment.
#
# Copy to .env.local and adjust:
#
#     cp .env.example .env.local
#
# Owned by Member 3.

# Base URL of the SolarIQ FastAPI service. The browser runs this JavaScript on
# the host, not inside Docker, so this must be a host-reachable address
# (localhost:8000) even when the API itself runs in Compose — the browser
# cannot resolve the Docker service name "api". See docs/demo-runbook.md.
VITE_API_BASE_URL=http://localhost:8000
