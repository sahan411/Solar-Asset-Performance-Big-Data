    {
      "id": 7,
      "type": "table",
      "title": "Current grid load & renewable mix by zone",
      "description": "Latest simulated hour with at least 75% of its readings, per zone.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT grid_zone AS \"Zone\",\n  to_char(window_start, 'YYYY-MM-DD HH24:00') AS \"Hour\",\n  ROUND(consumption_kwh::numeric, 1) AS \"Load (kWh)\",\n  ROUND(solar_kwh::numeric, 1) AS \"Solar (kWh)\",\n  ROUND(net_grid_load_kwh::numeric, 1) AS \"Net from grid (kWh)\",\n  ROUND(renewable_pct::numeric, 1) AS \"Renewable %\"\nFROM (SELECT DISTINCT ON (grid_zone) * FROM zone_load_hourly\n  WHERE readings >= 0.75 * expected_readings ORDER BY grid_zone, window_start DESC) z ORDER BY grid_zone"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Renewable %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "green",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Low-renewable alerts",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(created_at, 'HH24:MI:SS') AS \"Raised at (real)\",\n  grid_zone AS \"Zone\", to_char(window_start, 'YYYY-MM-DD HH24:00') AS \"Simulated hour\",\n  value AS \"Renewable %\", threshold AS \"Threshold %\"\nFROM alerts ORDER BY created_at DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Grid load by zone, last 24 simulated hours (kWh)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(window_start, 'MM-DD HH24:00') AS hour,\n  ROUND(SUM(CASE WHEN grid_zone = 'north' THEN consumption_kwh END)::numeric, 1) AS \"north\",\n  ROUND(SUM(CASE WHEN grid_zone = 'central' THEN consumption_kwh END)::numeric, 1) AS \"central\",\n  ROUND(SUM(CASE WHEN grid_zone = 'south' THEN consumption_kwh END)::numeric, 1) AS \"south\"\nFROM zone_load_hourly\nWHERE window_start > (SELECT MAX(window_start) FROM zone_load_hourly) - INTERVAL '24 hours'\nGROUP BY window_start ORDER BY window_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "hour",
        "orientation": "vertical",
        "stacking": "none",
        "showValue": "never",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
