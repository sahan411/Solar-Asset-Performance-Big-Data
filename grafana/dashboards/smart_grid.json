          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT household_id AS \"Household\",\n  grid_zone AS \"Zone\",\n  ROUND(consumption_kwh::numeric, 2) AS \"Used (kWh)\",\n  ROUND(solar_kwh::numeric, 2) AS \"Solar (kWh)\",\n  ROUND(grid_import_kwh::numeric, 2) AS \"From grid (kWh)\",\n  ROUND(solar_export_kwh::numeric, 2) AS \"To grid (kWh)\",\n  ROUND(solar_contribution_pct::numeric, 1) AS \"Solar share %\",\n  tariff_rate AS \"Rate / kWh\", billing_tier AS \"Tier\",\n  CASE WHEN subsidy_flag THEN 'yes' ELSE 'no' END AS \"Subsidy\",\n  energy_charge AS \"Energy\", solar_credit AS \"Solar credit\",\n  service_charge AS \"Service\", subsidy_discount AS \"Subsidy disc.\",\n  total_bill AS \"Total bill\"\nFROM daily_bills\nWHERE bill_date = (SELECT MAX(bill_date) FROM billing_runs)\nORDER BY household_id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
