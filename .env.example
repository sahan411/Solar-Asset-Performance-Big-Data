# SolarIQ — example environment.
#
# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#     cp .env.example .env
#
# Defaults below are the Docker Compose values: service names, not localhost.
# Running a component directly on the host instead means overriding the
# addresses (see "Host execution" at the bottom) rather than editing the code.
#
# Owned by Member 1, but shared. Append documented variables; do not rename
# existing ones — Member 2's processing/common/config.py reads several of these
# by the same name, so a rename is a contract change needing team agreement.

# ---------------------------------------------------------------------------
# Kafka  (producer: Member 1  |  consumer: Member 2)
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TELEMETRY_TOPIC=solar.telemetry.raw
KAFKA_INVALID_TOPIC=solar.telemetry.invalid
KAFKA_ALERT_TOPIC=solar.alerts

# ---------------------------------------------------------------------------
# Simulated clock and determinism
# ---------------------------------------------------------------------------

# Real seconds that one simulated day is compressed into. 300 = 5 real minutes
# per simulated day, a 288x compression. Event timestamps still span a full
# 24 hours; see simulators/common/time.py.
SIMULATION_DAY_SECONDS=300

# Real seconds between telemetry ticks. Every inverter emits once per tick, so
# the default portfolio produces 35 events every 3 seconds.
TELEMETRY_INTERVAL_SECONDS=3

# Fixed seed for the noise in the generation model. The same seed replays the
# same run, which is what makes the assessment demo reproducible. Changing it
# changes every generated number.
SIMULATION_SEED=8203

# Simulated calendar date of the first simulated day (ISO, YYYY-MM-DD).
SIMULATION_START_DATE=2026-08-21

# Where the daily reference feed is written, and where Airflow reads it from.
# Must resolve to the same mounted volume in both containers.
SIMULATION_OUTPUT_DIR=/data/daily

# Shared plant/inverter definition. Read by the simulator and by Member 2's
# storage/seed_portfolio.py, so both agree on which assets exist.
PORTFOLIO_CONFIG_PATH=simulators/config/portfolio.yaml

# Publish deliberately malformed records to exercise the quarantine path.
# MUST stay false for the assessment demo.
SIMULATION_EMIT_INVALID_EVENTS=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Port the simulator exposes Prometheus metrics on.
PROMETHEUS_PORT=9101

# Staleness budget for the no-telemetry health rule: alert when no telemetry has
# been produced for this many seconds. Keep in step with the `for:` duration in
# observability/alert-rules/.
NO_TELEMETRY_ALERT_SECONDS=60

# DEBUG | INFO | WARNING | ERROR. Applies to every subsystem's structured logger.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Host execution
# ---------------------------------------------------------------------------
# Running a component on the host rather than inside Compose means the Docker
# service names above do not resolve. Override the addresses, do not change the
# defaults:
#
#     KAFKA_BOOTSTRAP_SERVERS=localhost:29092
#     SIMULATION_OUTPUT_DIR=./data/daily
#
# ---------------------------------------------------------------------------
# Owned by other members
# ---------------------------------------------------------------------------
# The processing, storage and serving subsystems read further variables
# (DATABASE_URL, MINIO_*, SPARK_*, STREAM_*, ALERT_SUSTAIN_SECONDS, ...).
# Member 2 and Member 3 append those here as their milestones land; the
# canonical list for the processing side is processing/common/config.py.
#
# Never commit a real credential to this file. It documents variable names and
# safe local-development values only.
